  "db_name": "PostgreSQL",
  "query": "select j.id, j.kind, j.mail_account_id, j.status, j.started_at,\n                  j.finished_at, j.stats, j.error\n           from jobs j\n           join mail_accounts a on a.id = j.mail_account_id\n           where a.user_id = $1 and j.status = 'running'\n           order by j.started_at",
