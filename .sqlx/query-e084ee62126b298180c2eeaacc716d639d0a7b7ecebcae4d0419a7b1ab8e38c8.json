{
  "db_name": "PostgreSQL",
  "query": "update mcp_tokens t\n           set last_used_at = now()\n           from users u\n           where t.token_hash = $1\n             and t.revoked_at is null\n             and u.id = t.user_id\n             and u.disabled_at is null\n           returning t.id, t.user_id, t.label, t.created_at, t.last_used_at, t.revoked_at",
