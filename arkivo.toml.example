# Arkivo configuration. Every key can also be set via ARKIVO_* env vars
# (double underscore for nesting: ARKIVO_OPENSEARCH__URL).

database_url = "postgres://arkivo:arkivo@localhost:5432/arkivo"
maildir_root = "./data/mail"
# 32 bytes, hex-encoded — seals mail credentials (Fastmail tokens, Gmail
# refresh tokens, IMAP passwords) at rest. Keep out of git.
master_key_path = "./data/master.key"

[opensearch]
url = "http://localhost:9200"
# username = "admin"
# password = "..."

[embedding]
url = "http://localhost:11434"
model = "nomic-embed-text"
dimension = 768
num_ctx = 8192

[web]
bind = "127.0.0.1:8080"
# Must equal the effective domain the browser sees, or WebAuthn fails.
rp_id = "localhost"
rp_origin = "http://localhost:8080"

[mcp]
bind = "127.0.0.1:8081"
# allowed_hosts = ["arkivo.example.com"]  # empty disables Host checks

[defaults]
recency_cutoff_days = 7
deletion_policy = "retain"  # or "mirror"

# Optional: enables the "Connect Gmail" flow. Create an Internal OAuth
# client (web application) in the Workspace's Google Cloud project with
# redirect URI {rp_origin}/oauth/google/callback and the
# gmail.readonly scope.
# [google]
# client_id = "1234567890-abc.apps.googleusercontent.com"
# client_secret = "..."  # prefer ARKIVO_GOOGLE__CLIENT_SECRET

# Optional: enables the "Connect Microsoft 365" flow. Register an app in
# Entra ID (Web platform, redirect URI {rp_origin}/oauth/microsoft/callback)
# with delegated Mail.Read, User.Read, and offline_access. tenant is
# "common" (any work/school or personal account), "organizations",
# "consumers", or a tenant id to lock the flow to one directory.
# [microsoft]
# client_id = "00000000-0000-0000-0000-000000000000"
# client_secret = "..."  # prefer ARKIVO_MICROSOFT__CLIENT_SECRET
# tenant = "common"
